[Unit]
Description=Yaesm backup scheduler
Documentation=man:yaesm(1)
ConditionPathExists=/etc/yaesm/config.yaml

[Service]
Type=exec
RuntimeDirectory=yaesm
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
KillMode=mixed
ExecStart=/usr/bin/yaesm --config /etc/yaesm/config.yaml --log-stderr run --no-stderr-timestamps
ExecReload=/bin/kill -HUP $MAINPID
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15s

[Install]
WantedBy=multi-user.target
